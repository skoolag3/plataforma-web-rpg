@startuml
title Diagrama de Containers
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 16
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #52606D

rectangle "Navegador\n<<cliente>>" as navegador #F2F4F7
rectangle "Frontend Next.js\n<<container>>\nReact e TypeScript" as frontend #EAF2FF
rectangle "API NestJS\n<<container>>\nRegras, autenticação e motor" as api #F0EAFE
database "PostgreSQL\n<<banco de dados>>" as banco #EAF7EF
rectangle "Stripe\n<<serviço externo>>" as stripe #FFF6D9
rectangle "Cloudinary e Storage\n<<serviços externos>>" as midia #FFF6D9
rectangle "SMTP\n<<serviço externo>>" as smtp #FFF6D9
rectangle "IA generativa\n<<serviço externo>>\nGemini ou OpenAI" as ia #FCEBEC

navegador --> frontend : HTTPS
frontend --> api : HTTP / REST
api --> banco : Prisma ORM
api --> stripe : checkout / webhook
api --> midia : mídia
api --> smtp : e-mail
api ..> ia : evento do chefe
@enduml
