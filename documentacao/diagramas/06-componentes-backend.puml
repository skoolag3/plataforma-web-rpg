@startuml
title Componentes do Backend NestJS
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #52606D
skinparam componentStyle rectangle

component "Controllers HTTP" as controllers #EAF2FF
component "Auth e Perfil" as auth #F0EAFE
component "Coleção e Decks" as colecao #F0EAFE
component "Gacha e Recompensas" as gacha #F0EAFE
component "Administração" as admin #F0EAFE
component "Motor de Batalha" as batalha #FFF6D9
component "Expedições" as expedicao #FFF6D9
component "Integrações Externas" as integracoes #FFF6D9
component "Ledger e Auditoria" as auditoria #F2F4F7
component "PrismaService" as prisma #EAF7EF
database "PostgreSQL" as banco #EAF7EF

controllers --> auth
controllers --> colecao
controllers --> gacha
controllers --> admin
colecao --> batalha : fornece deck
expedicao --> batalha : inicia confronto
batalha --> expedicao : informa resultado
gacha --> auditoria : registra movimentação
admin --> auditoria : registra autoria
auth --> prisma
colecao --> prisma
gacha --> prisma
admin --> prisma
batalha --> prisma
expedicao --> prisma
auditoria --> prisma
prisma --> banco
expedicao ..> integracoes : IA prevista
gacha --> integracoes : Stripe e mídia
@enduml
