@startuml
title Casos de Uso Gerais da Plataforma AnimeCards
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 16
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #52606D
skinparam ActorBorderColor #364152
skinparam ActorFontColor #202B37
skinparam UsecaseBorderColor #4F46E5
skinparam UsecaseBackgroundColor #EEF2FF
skinparam UsecaseFontColor #202B37
skinparam PackageBorderColor #94A3B8
skinparam PackageBackgroundColor #F8FAFC

actor "Usuário" as usuario
actor "Administrador" as admin
actor "Stripe" as stripe
actor "Serviços de mídia\ne e-mail" as externos
actor "IA generativa\n(prevista)" as ia

rectangle "Plataforma AnimeCards" {
  usecase "Gerenciar conta\ne perfil" as ucConta
  usecase "Consultar coleção" as ucColecao
  usecase "Gerenciar decks" as ucDeck
  usecase "Obter cartas\nno gacha" as ucGacha
  usecase "Resgatar\nrecompensas" as ucRecompensa
  usecase "Comprar Rubys" as ucCompra
  usecase "Participar de\nbatalha" as ucBatalha
  usecase "Participar de\nexpedição" as ucExpedicao
  usecase "Consultar ranking\ne histórico" as ucRanking
  usecase "Administrar\nconteúdo" as ucAdmin
  usecase "Configurar\nbalanceamento" as ucBalanceamento
  usecase "Processar evento\ndo chefe" as ucChefe
}

usuario -- ucConta
usuario -- ucColecao
usuario -- ucDeck
usuario -- ucGacha
usuario -- ucRecompensa
usuario -- ucCompra
usuario -- ucBatalha
usuario -- ucExpedicao
usuario -- ucRanking

admin -- ucAdmin
admin -- ucBalanceamento
stripe -- ucCompra
externos -- ucConta
ia -- ucChefe

ucExpedicao ..> ucBatalha : <<include>>
ucExpedicao ..> ucChefe : <<include>>
ucAdmin ..> ucBalanceamento : <<include>>
@enduml
